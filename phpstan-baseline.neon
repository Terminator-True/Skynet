parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 2
			path: app/Console/Commands/OllamaGate.php

		-
			message: '#^Method App\\Console\\Commands\\OllamaGate\:\:installedModels\(\) should return list\<string\>\|null but returns array\<int, mixed\>\.$#'
			identifier: return.type
			count: 1
			path: app/Console/Commands/OllamaGate.php

		-
			message: '#^Method App\\Console\\Commands\\OllamaGate\:\:probeTool\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Console/Commands/OllamaGate.php

		-
			message: '#^Unable to resolve the template type TKey in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Console/Commands/OllamaGate.php

		-
			message: '#^Unable to resolve the template type TValue in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Console/Commands/OllamaGate.php

		-
			message: '#^Strict comparison using \=\=\= between string and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Http/Controllers/GoogleOAuthController.php

		-
			message: '#^Using nullsafe property access "\?\-\>scopes" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/GoogleOAuthController.php

		-
			message: '#^Method App\\Services\\ChatOrchestrator\:\:toolMessage\(\) should return array\{role\: ''tool'', content\: string, tool_name\: string\} but returns array\{role\: ''tool'', content\: non\-empty\-string\|false, tool_name\: string\}\.$#'
			identifier: return.type
			count: 1
			path: app/Services/ChatOrchestrator.php

		-
			message: '#^Method App\\Services\\ChatTurnResult\:\:__construct\(\) has parameter \$toolCalls with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/ChatTurnResult.php

		-
			message: '#^Method App\\Services\\ChatTurnResult\:\:toArray\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/ChatTurnResult.php

		-
			message: '#^Call to function is_array\(\) with mixed will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: app/Services/Google/ApiclientGoogleOAuthClient.php

		-
			message: '#^Offset ''error'' on \*NEVER\* on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Services/Google/ApiclientGoogleOAuthClient.php

		-
			message: '#^Offset ''error_description'' on \*NEVER\* on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Services/Google/ApiclientGoogleOAuthClient.php

		-
			message: '#^Property App\\Models\\GoogleToken\:\:\$expires_at \(Illuminate\\Support\\Carbon\|null\) does not accept Carbon\\CarbonImmutable\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Services/Google/GoogleClientFactory.php

		-
			message: '#^Strict comparison using \!\=\= between string and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: app/Services/Google/GoogleClientFactory.php

		-
			message: '#^Strict comparison using \=\=\= between string and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Services/Google/GoogleClientFactory.php

		-
			message: '#^Method App\\Services\\Ollama\\OllamaClient\:\:decodeArguments\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/Ollama/OllamaClient.php

		-
			message: '#^Parameter \#1 \$string of function rtrim expects string, bool\|string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: config/services.php
